# ────────────────────────────────────────────────────────────────────────────
# eHomeo backend — required environment variables
# Copy this file to .env and fill in every value before starting the app.
# Generate secrets with: openssl rand -hex 32
# ────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Values: dev | staging | prod | production
ENV=dev
APP_NAME=HPHomeo
# Public-facing base URL of the FRONTEND (used for CORS, CSRF, email links).
# Production example: https://hphomeo.com
APP_BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Full MongoDB Atlas connection string — treated as a secret (never logged).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&maxPoolSize=10
MONGODB_DB=ehomeo

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth & Security ───────────────────────────────────────────────────────────
# All three must be independent secrets (openssl rand -hex 32).
JWT_SECRET=<32-byte-hex>
JWT_ALGO=HS256
JWT_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=30

OTP_SECRET=<32-byte-hex>
OTP_RESEND_COOLDOWN_SECONDS=60

# Used to encrypt TOTP secrets at rest. Must NOT be the same as JWT_SECRET.
TOTP_ENCRYPTION_KEY=<32-byte-hex>

# ── Cookie settings ───────────────────────────────────────────────────────────
# COOKIE_SECURE must be true in production (forced by startup validator for ENV=prod/staging).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.hphomeo.com   # uncomment and set for cross-subdomain cookies

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# Leave blank to disable Sentry.
SENTRY_DSN=
# Must match ENV: development | staging | production
SENTRY_ENVIRONMENT=development

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Use rzp_live_... keys in production/staging — startup will refuse rzp_test_ keys.
RAZORPAY_KEY_ID=rzp_live_<key>
RAZORPAY_KEY_SECRET=<secret>
# Generate with: openssl rand -hex 32  — set this in Razorpay dashboard too.
RAZORPAY_WEBHOOK_SECRET=<32-byte-hex>

# ── Email — Resend ────────────────────────────────────────────────────────────
# Leave blank to disable email sending.
RESEND_API_KEY=
EMAIL_FROM=HPHomeo <noreply@yourdomain.com>

# ── WhatsApp — Meta Cloud API ─────────────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_OTP_TEMPLATE_NAME=<your_meta_template_name>
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=appointment_confirmation_1
WHATSAPP_REMINDER_TEMPLATE_NAME=appointment_reminder
WHATSAPP_RESCHEDULE_TEMPLATE_NAME=appointment_reschedule_1
WHATSAPP_CANCELLATION_TEMPLATE_NAME=appointment_cancel
WHATSAPP_REMINDER_LEAD_HOURS=12
WHATSAPP_PUBLIC_APPOINTMENT_PATH_PREFIX=public/appointments

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# ── LiveKit (video) ───────────────────────────────────────────────────────────
# All three must be set when VIDEO_ENABLED=true — startup will reject partial config.
VIDEO_ENABLED=false
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=<api_key>
LIVEKIT_API_SECRET=<api_secret>
# Optional: override the webhook signing secret (defaults to LIVEKIT_API_SECRET if blank).
LIVEKIT_WEBHOOK_SECRET=

# ── Admin bootstrap (dev/staging only) ───────────────────────────────────────
# Creates the first admin account on startup if no admin exists.
# Set ADMIN_BOOTSTRAP_ENABLED=false in production.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=
ADMIN_BOOTSTRAP_REGISTRATION_NO=
